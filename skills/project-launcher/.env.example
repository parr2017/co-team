# project-launcher 配置
# 复制为 .env 后按需修改。所有 LAUNCHER_* 变量由 scripts/launcher.py 启动时读取。

# ===== 日志 =====
# 默认日志目录（不设置则使用 ./logs 或 %TEMP%/project-launcher）
LAUNCHER_LOG_DIR=

# ===== JDK（Java 项目关键！）=====
# 系统 PATH 可能是 Java 8，但 Spring Boot 3 项目需要 Java 17。
# 显式指定项目所需的 JDK；不设置时 launcher 从 pom.xml 自动检测并扫描常见安装目录。
# 本项目正确值示例：
LAUNCHER_JAVA_HOME=D:\JAVA\jdk-17.0.9

# ===== 默认 conda 环境（可选）=====
# 设置后，所有目标命令默认在该 conda env 中执行（除非 --no-conda 或显式 --conda-env）。
# 留空 = 默认使用系统 PATH python（零依赖兜底）。
LAUNCHER_DEFAULT_CONDA_ENV=
# conda env 不存在时自动创建使用的 Python 版本
LAUNCHER_CONDA_PYTHON=3.9

# ===== Python / Node =====
# Python 解释器路径（默认使用 PATH 中的 python）
LAUNCHER_PYTHON=python
# Node.js / npm 路径
LAUNCHER_NODE=node
LAUNCHER_NPM=npm

# ===== 默认 JVM 参数（启动 Java 时附加，也可用 --java-opts 覆盖）=====
LAUNCHER_JAVA_OPTS=-Xmx512m

# ===== 默认端口（当无法自动检测时使用）=====
LAUNCHER_DEFAULT_PORT_JAVA=8080
LAUNCHER_DEFAULT_PORT_PYTHON=8000
LAUNCHER_DEFAULT_PORT_NODE=5173
