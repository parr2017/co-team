{
  "name": "co-team-server",
  "version": "0.2.0",
  "main": "dist/index.js",
  "bin": {
    "coteam-cli": "dist/cli.js"
  },
  "scripts": {
    "build": "npm --prefix .. run build:shared && tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/opencode/officialClientLoader.cjs','dist/opencode/officialClientLoader.cjs')\"",
    "dev": "npm --prefix .. run build:shared && tsx watch src/index.ts",
    "cli": "npm --prefix .. run build:shared && tsx src/cli.ts",
    "test": "npm --prefix .. run build:shared && vitest run"
  },
  "dependencies": {
    "@co-team/opencode-sync": "*",
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opencode/client": "2.0.15",
    "@opencode/schema": "2.0.15",
    "hono": "^4.6.0",
    "ioredis": "^5.4.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.70.0",
    "simple-git": "^3.27.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
